@{
    ViewBag.Title = "Obtener Dominio de Correo";
}


<h2>Obtener Dominio de Correo</h2>

@using (Html.BeginForm("Dominio", "Correo", FormMethod.Post))
{
    <label>Correo electrónico:</label>
    <input type="email" name="email" required />
    <input type="submit" value="Obtener Dominio" />
}

@if (ViewBag.Mensaje != null)
{
    <p><strong>@ViewBag.Mensaje</strong></p>
}