@{
    ViewBag.Title = "Convertir Temperatura";
}

<h2>Convertir Celsius a Fahrenheit</h2>

@using (Html.BeginForm())
{
    <div>
        <label>Temperatura en Celsius:</label>
        <input type="number" name="celsius" step="0.1" required />
        <input type="submit" value="Convertir" />
    </div>
}

@if (Model != null)
{
    <h3>Resultado:</h3>
    <p><strong>Celsius:</strong> @Model.Celsius °C</p>
    <p><strong>Fahrenheit:</strong> @Model.Fahrenheit °F</p>
}